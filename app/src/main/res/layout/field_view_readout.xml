<?xml version="1.0" encoding="utf-8"?>
<!--
  Standard-Karoo readout layout for the passive numeric info fields (CarbBurnRate,
  CarbAvgBurnRate, CarbsBurned, CaloriesTotal, CaloriesRate).

  Structure (vertical LinearLayout with weights — most reliable in RemoteViews):
    - TOP row  (wrap_content): accent-tinted icon + units/label.
    - REMAINING space (weight=1): LinearLayout with gravity="center_vertical"
      that centres the big bold value in whatever height is left below the header.

  Karoo-theme passthrough: NO background colour set via RemoteViews; text colours
  are set explicitly at runtime from Context.isKarooNightMode().
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/field_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="2dp">

    <!-- Header row: accent-tinted metric icon + units/label. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/field_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="3dp"
            android:scaleType="fitCenter"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/field_text_hint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:textColor="#CCFFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Value area: takes ALL remaining vertical space after the header row,
         then gravity="center_vertical" centres the number within that space.
         android:gravity on a LinearLayout is a container property (not a child
         layout param) so RemoteViews applies it correctly. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:id="@+id/field_text_main"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>
