<?xml version="1.0" encoding="utf-8"?>
<!-- Tappable fueling prompt overlay. SEPARATE from overlay_sos_cancel.xml / overlay_info.xml. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="5dp" android:paddingEnd="5dp" android:paddingTop="6dp" android:paddingBottom="3dp">
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@drawable/bg_fueling_overlay" android:clipToOutline="true" android:elevation="12dp"
        android:gravity="center_vertical" android:orientation="horizontal"
        android:paddingStart="14dp" android:paddingEnd="10dp" android:paddingTop="13dp" android:paddingBottom="13dp">
        <TextView android:id="@+id/tv_fuel_icon" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginEnd="10dp" android:text="@string/fueling_overlay_icon" android:textSize="28sp" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/tv_fuel_title" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="#FFFFFF" android:textSize="24sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/tv_fuel_detail" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="#FFB2EBF2" android:textSize="18sp" android:layout_marginTop="2dp" android:maxLines="2" android:ellipsize="end" />
        </LinearLayout>
        <!-- Two-line action button: big EAT / DRINK verb on top, the amount (e.g. "25 g")
             below. The whole LinearLayout is the click target (id btn_fuel_action). -->
        <LinearLayout android:id="@+id/btn_fuel_action" android:layout_width="96dp" android:layout_height="70dp"
            android:layout_marginStart="6dp" android:background="@drawable/bg_fueling_button" android:clipToOutline="true"
            android:orientation="vertical" android:gravity="center"
            android:clickable="true" android:focusable="true">
            <TextView android:id="@+id/btn_fuel_action_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#FF00838F" android:textSize="24sp" android:textStyle="bold"
                android:maxLines="1" android:includeFontPadding="false" />
            <TextView android:id="@+id/btn_fuel_action_amount" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#FF00838F" android:textSize="15sp"
                android:maxLines="1" android:includeFontPadding="false" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
