<?xml version="1.0" encoding="utf-8"?>
<!-- Tappable fueling prompt overlay. SEPARATE from overlay_sos_cancel.xml / overlay_info.xml. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="5dp" android:paddingEnd="5dp" android:paddingTop="6dp" android:paddingBottom="3dp">
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@drawable/bg_fueling_overlay" android:clipToOutline="true" android:elevation="12dp"
        android:gravity="center_vertical" android:orientation="horizontal"
        android:paddingStart="14dp" android:paddingEnd="10dp" android:paddingTop="10dp" android:paddingBottom="10dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginEnd="10dp" android:text="🍫" android:textSize="26sp" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/tv_fuel_title" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/tv_fuel_detail" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="#FFE0B2" android:textSize="13sp" android:layout_marginTop="2dp" android:maxLines="2" android:ellipsize="end" />
        </LinearLayout>
        <TextView android:id="@+id/btn_fuel_action" android:layout_width="100dp" android:layout_height="62dp"
            android:layout_marginStart="8dp" android:background="@drawable/bg_fueling_button" android:clipToOutline="true"
            android:gravity="center" android:textColor="#BF360C" android:textSize="14sp" android:textStyle="bold"
            android:clickable="true" android:focusable="true" />
    </LinearLayout>
</FrameLayout>
