    <string name="sensitivity_custom">Custom threshold</string>
    <!-- Sensitivity descriptions — note: "High sensitivity" means a LOWER impact threshold (detects lighter hits).
         The naming follows the standard sensor convention: higher sensitivity = reacts to smaller signals. -->
    <string name="sensitivity_low_desc">⛰ MTB · Gravel · Enduro. Requires a very hard impact (~5.5g) to trigger. MTB jump landings and drops rarely exceed this, so false positives from rough terrain are minimal. Use if you experience unwanted alerts on technical or rocky terrain.</string>
    <string name="sensitivity_medium_desc">🚴 Road + MTB mixed (recommended default). Balanced threshold (~4.5g) — detects most real crashes while tolerating normal road bumps and moderate trail impacts. Good starting point for any discipline. Min. speed 10 km/h.</string>
    <string name="sensitivity_high_desc">🏁 Smooth road only (velodrome, closed circuit, bike path). Lower threshold (~3.5g) — more sensitive, detects lighter crashes. Safe to use on perfectly smooth surfaces where normal riding never generates large impacts. Do NOT use on MTB or rough roads — frequent false positives. Min. speed 15 km/h.</string>
    <string name="sensitivity_custom_desc">🔧 Custom threshold. Set the exact impact value with the slider below.\n• Higher value → harder impact required → fewer false positives\n• Lower value → detects lighter impacts → more sensitive\nUseful if none of the presets match your riding style (e.g. aggressive enduro, triathlon on smooth roads).</string>
    <string name="sensitivity_custom_threshold">Impact threshold: %1$d m/s²</string>
    <string name="min_speed_label">Min. speed to detect crash (km/h, 0 = always)</string>
    <string name="min_speed_hint_low">MTB/gravel: 3 km/h recommended — crashes on technical climbs can happen at walking pace. Set to 0 to detect at any speed (more false positives when handling the bike).</string>
    <string name="min_speed_hint_medium">Road + MTB: 10 km/h recommended — ignores impacts while nearly stopped (e.g. putting the bike on the car). Reduce to 3 km/h for MTB technical sections.</string>
    <string name="min_speed_hint_high">Smooth road: 15 km/h recommended — road crashes at very low speed are extremely rare. Set to 0 only for testing.</string>
    <string name="min_speed_hint_custom">Choose based on your riding style. 0 = detect at any speed (useful for testing). Higher values reduce false positives when handling the bike at rest.</string>
    <string name="crash_confirm_speed_label">Max. speed to confirm crash (km/h)</string>
    <string name="crash_confirm_speed_hint">Speed below which the rider is considered stopped after an impact. Default 5 km/h. Increase to 8 km/h for MTB/gravel where sliding after a crash is common. Lower values (3) are stricter and reduce false positives on slow climbs.</string>
    <string name="crash_outside_ride_label">Monitor crash when not riding</string>
    <string name="crash_outside_ride_desc">Keeps crash detection active even when no ride is recording. Uses the minimum speed configured above. Useful if you want protection while doing a warm-up or a quick spin without starting a recording.</string>
    <string name="crash_outside_ride_any_speed_label">Monitor crash when not riding — any speed</string>
    <string name="crash_outside_ride_any_speed_desc">Same as above but detects crashes at any speed, even while stationary (minimum speed is ignored). ⚠ This can produce more false positives — picking up or dropping the device while still may trigger an alert.</string>
    <string name="crash_outside_ride_warning">⚠ Crash monitoring is active outside of a recorded ride. The device must be moving at the minimum speed configured above (%1$d km/h).</string>
    <string name="speed_drop_label">Detect prolonged stop during ride</string>
    <string name="speed_drop_minutes_label">Minutes stopped before alert</string>
    <string name="checkin_timer_label">Check-in timer</string>
    <string name="checkin_interval_label">Check-in interval (minutes)</string>
    <string name="checkin_warning_title">Check-in in %1$d min</string>
    <string name="checkin_warning_detail">Tap the Check-in field to confirm you\'re OK</string>
    <string name="checkin_hint">Add the \"KSafe Check-in\" field to a data page: tap it during the ride to confirm you\'re OK and reset the timer. You\'ll be reminded with beeps 5 and 1 min before it expires. If the timer runs out without a tap, your contacts are alerted automatically — so reset it well before it expires.</string>
    <string name="active_label">Extension active</string>
    <string name="karoo_live_label">Notify contacts on ride start</string>
    <string name="karoo_live_hint">Sends a message when the ride starts (first start only — resuming after a pause does NOT send it again). Requires a Karoo Live key to include the tracking link; leave the key empty to send a plain message without a link.</string>
    <string name="karoo_live_key_label">Karoo Live key (optional)</string>
    <string name="karoo_live_supporting">Only the key part of the URL — e.g. from https://dashboard.hammerhead.io/live/3738Ag enter 3738Ag. Leave empty to send without a tracking link.</string>
    <string name="karoo_live_message_label">Ride start message</string>
    <string name="karoo_live_message_hint">Use {livetrack} to insert the live tracking link (only included if a key is configured). You can also use {livetrack} in your emergency message.</string>
    <string name="karoo_live_end_label">Notify contacts on ride end</string>
    <string name="karoo_live_end_message_label">Ride end message</string>
    <string name="karoo_live_end_message_hint">Message sent when the ride recording stops completely. Does not require a Karoo Live key.</string>
