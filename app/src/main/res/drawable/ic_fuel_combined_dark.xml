        <path android:fillColor="#FF000000" android:pathData="M10.5,1.5 L13.5,1.5 L13.5,3 L10.5,3 Z" />
        <path android:fillColor="#FF000000" android:pathData="M9.5,3 L14.5,3 L14.5,5 L9.5,5 Z" />
