<?xml version="1.0" encoding="utf-8"?>
<!-- Calm teal "info" palette — deliberately NOT the red/amber of an emergency alert, so a
     fuelling nudge never reads as a crash/SOS. Matches the teal accent of the readout fields. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <solid android:color="#E600838F" />

    <stroke
        android:width="2dp"
        android:color="#FF26C6DA" />

    <corners android:radius="14dp" />

</shape>
